<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>To-Do List</title>
</head>
<body>
    <h1>Tasks</h1>
    <ul>
    <% for (let i = 0; i < tasks.length; i++) { %>
        <li><%= tasks[i].taskName %></li>
    <% } %>
    </ul>
    <form action="/api/tasks" method="POST">
        <input type="text" name="taskName">
        <input type="submit">
    </form>
</body>
</html>