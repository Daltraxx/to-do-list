<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="css/styles.css" rel="stylesheet">
    <title>To-Do List</title>
</head>
<body>
    <h1>Tasks</h1>
    <ul>
    <% for (let i = 0; i < tasks.length; i++) { %>
        <li>
        <% if (tasks[i].completed) { %>
            <span class="task complete" id="<%= tasks[i]._id %>"><%= tasks[i].taskName %></span>
        <% } else { %>
            <span class="task" id="<%= tasks[i]._id %>"><%= tasks[i].taskName %></span>
        <% } %>
            <button class="remove-btn" value="<%= tasks[i]._id %>">Remove</button>
        </li>
    <% } %>
    </ul>
    <form action="/api/tasks" method="POST">
        <input type="text" name="taskName">
        <input type="submit">
    </form>

    <script src="/main.js" type="module"></script>
</body>
</html>